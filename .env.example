# Set this only in a private local .env file after registering the token in
# Firebase Console > App Check > Apps > Manage debug tokens.
VITE_APP_CHECK_DEBUG=true

# Required for a public web deployment that uses reCAPTCHA Enterprise.
# A Chrome extension needs a separate attestation strategy and is tested
# with its own App Check debug token during development.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
