{
  "manifest_version": 3,
  "name": "Clariway: Image Access",
  "description": "Find missing image alt text with user-controlled hybrid AI.",
  "version": "0.1.0",
  "minimum_chrome_version": "139",
  "permissions": ["activeTab", "scripting", "sidePanel", "tts"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Clariway"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "open-clariway": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Open Clariway"
    }
  }
}
